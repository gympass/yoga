#!/bin/bash

BRANCH=`git rev-parse --abbrev-ref HEAD`
echo "on branch $BRANCH"

set -e

if [[ $BRANCH == "master" ]];
then
  # lerna pushes the release commit and tags before publishing to npm, so a failed publish leaves
  # versions that exist in git but not on npm. Publish those first (no-op when nothing is pending).
  yarn lerna publish from-package --yes --loglevel silly
  yarn lerna publish --yes --no-verify-access --loglevel silly --ignore-changes @gympass/yoga-doc
elif [[ $BRANCH == "alpha" || $BRANCH == "beta" ]];
then
  yarn lerna publish --conventional-prerelease --yes --preid $BRANCH --dist-tag $BRANCH
else
  echo "Nothing to publish on branch $BRANCH..."
fi
